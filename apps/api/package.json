{
  "name": "@slotflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node --watch --watch-path=dist dist/main.js",
    "test": "vitest run",
    "migrate": "tsx src/migrate-cli.ts",
    "seed": "tsx src/seed-cli.ts",
    "migrate:prod": "node dist/migrate-cli.js",
    "seed:prod": "node dist/seed-cli.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "seed:bookings": "tsx src/seed-bookings-cli.ts",
    "bench:availability": "tsc -p tsconfig.json && node dist/bench/availability-bench.js",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@slotflow/core": "workspace:*",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc/core": "^1.9.2",
    "@types/express": "^4.17.25",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "unplugin-swc": "^1.5.1"
  }
}
