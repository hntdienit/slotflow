{
  "name": "slotflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @slotflow/core --filter @slotflow/llm build && pnpm -r typecheck",
    "test": "pnpm --filter @slotflow/core --filter @slotflow/llm build && pnpm -r test",
    "format": "prettier --write .",
    "eval": "pnpm --filter @slotflow/llm eval"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5",
    "@types/node": "^22.9.0",
    "@nestjs/testing": "^10.4.8"
  }
}
