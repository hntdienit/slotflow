# App connects as the non-superuser role (RLS enforced); migrations/seed use the admin URL.
DATABASE_URL=postgres://slotflow_app:slotflow_app@localhost:5432/slotflow
DATABASE_ADMIN_URL=postgres://slotflow:slotflow@localhost:5432/slotflow
REDIS_URL=redis://localhost:6379
PORT=3000
# Optional: real LLM provider for the assistant (M6). Leave empty to use MockProvider.
LLM_PROVIDER=mock
LLM_API_KEY=
