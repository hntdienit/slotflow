# App connects as the non-superuser role (RLS enforced); migrations/seed use the admin URL.
DATABASE_URL=postgres://slotflow_app:slotflow_app@localhost:5432/slotflow
DATABASE_ADMIN_URL=postgres://slotflow:slotflow@localhost:5432/slotflow
# Worker connects as slotflow_worker (BYPASSRLS, narrow grants): it serves every tenant.
WORKER_DATABASE_URL=postgres://slotflow_worker:slotflow_worker@localhost:5432/slotflow
# SQS + SES on LocalStack (docker compose up localstack). Unset to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
MAIL_FROM=no-reply@slotflow.local
REDIS_URL=redis://localhost:6379
PORT=3000
# Assistant (M6). Without ANTHROPIC_API_KEY (or with ASSISTANT_PROVIDER=mock) the offline MockProvider is used.
ASSISTANT_PROVIDER=mock
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_RATE_PER_MIN=20

# Waitlist: the worker asks the API to match freed slots (service-to-service, shared secret)
INTERNAL_API_KEY=dev-internal-key
API_URL=http://localhost:3000
WAITLIST_HOLD_MINUTES=10
